#!/usr/bin/env bash

current_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

compare_float() {
  if [ ${1%.*} -eq ${2%.*} ] && [ ${1#*.} \> ${2#*.} ] || [ ${1%.*} -gt ${2%.*} ]; then
    echo ">"
  else
    echo "<="
  fi
}

# Compact client detection - before the preview block below, because the
# compact layout turns the preview off.
#
# A client is "compact" when it is too narrow OR too short:
#   TMUX_FZF_CLIENT_WIDTH  / TMUX_FZF_CLIENT_HEIGHT, from the client that
#     pressed the key (main.tmux passes both). Phones report plenty of
#     columns and few rows - Termius in portrait is ~430x65, but a landscape
#     phone or a short split terminal is wide and cramped at the same time -
#     so a popup proportioned for a desktop window does not fit, and a preview
#     pane eats the width that makes the list readable.
#   The thresholds are fixed at 140 columns / 30 rows: generous desktop
#   windows clear both, phones and short splits do not.
#
# tmux could do this arithmetic itself (display-popup understands percentage
# sizes natively), but the comparison lives here so the plugin keeps working on
# the tmux versions it supports - and so a non-numeric width from an exotic
# client cannot break the shell test.
compact_client=0
if [ -n "$TMUX_FZF_CLIENT_WIDTH" ] && [ -n "$TMUX_FZF_CLIENT_HEIGHT" ]; then
    case "$TMUX_FZF_CLIENT_WIDTH$TMUX_FZF_CLIENT_HEIGHT" in
        *[!0-9]*) : ;;   # not a plain pair of integers, skip the comparison
        *)
            if [ "$TMUX_FZF_CLIENT_WIDTH" -lt 140 ] || [ "$TMUX_FZF_CLIENT_HEIGHT" -lt 30 ]; then
                compact_client=1
                TMUX_FZF_PREVIEW=0
            fi
            ;;
    esac
fi

# $TMUX_FZF_PREVIEW_OPTIONS && $TMUX_FZF_PREVIEW_SESSION_OPTIONS
TMUX_FZF_PREVIEW_FOLLOW="${TMUX_FZF_PREVIEW_FOLLOW:-1}"
fzf_version=$(fzf --version)
fzf_version_1=$(echo "$fzf_version" | grep -o '^[[:digit:]]*\.[[:digit:]]*')
fzf_version_2=$(echo "$fzf_version" | grep -o '^[[:digit:]]*\.[[:digit:]]*\.[[:digit:]]*' | sed 's/[[:digit:]]*\.//')
if [ $(compare_float $fzf_version_1 "0.24") == ">" ] ||
  [ $fzf_version_1 == "0.24" ] &&
  [ $(compare_float $fzf_version_2 "24.3") == ">" ] &&
  [ "$TMUX_FZF_PREVIEW_FOLLOW" == 1 ]; then
  fzf_preview_window_follow=":follow" # :follow option is only available in fzf >= 0.24.4
fi
TMUX_FZF_PREVIEW="${TMUX_FZF_PREVIEW:-1}"
if [ "$TMUX_FZF_PREVIEW" == 1 ]; then
  TMUX_FZF_PREVIEW_OPTIONS="--preview='$current_dir/.preview {}' --preview-window=$fzf_preview_window_follow"
  TMUX_FZF_PREVIEW_SESSION_OPTIONS="--preview='$current_dir/.preview-session {}' --preview-window=$fzf_preview_window_follow"
else
  TMUX_FZF_PREVIEW_OPTIONS="--preview='$current_dir/.preview {}' --preview-window=${fzf_preview_window_follow}:hidden"
  TMUX_FZF_PREVIEW_SESSION_OPTIONS="--preview='$current_dir/.preview-session {}' --preview-window=${fzf_preview_window_follow}:hidden"
fi

# $TMUX_FZF_BIN
if [ -x "$(command -v fzf-tmux)" ]; then
  TMUX_FZF_BIN="$(which fzf-tmux)"
else
  TMUX_FZF_BIN="$current_dir/.fzf-tmux"
fi

# $TMUX_FZF_OPTIONS
#
# Three sources, in this order of precedence:
#   1. TMUX_FZF_OPTIONS set by the user (tmux global environment) — untouched,
#      on every client: pinning the options means the layout is yours, phone
#      or desktop.
#   2. a compact client with nothing pinned: the built-in near-fullscreen
#      layout, preview pane off, inline info. Phones report plenty of columns
#      but few rows — Termius on a phone reports ~430x65 — so the popup that
#      looks fine on a desktop window is cramped there, and a preview pane eats
#      the width that makes the list readable.
#   3. the historical defaults below
#
# TMUX_FZF_OPTIONS_USER records that the user pinned the options, so the
# built-in compact branch does not silently discard their configuration.
TMUX_FZF_OPTIONS_USER=""
[ -n "$TMUX_FZF_OPTIONS" ] && TMUX_FZF_OPTIONS_USER=1

tmux_version=$(tmux -V | grep -oE '[0-9]+\.[0-9]*')
if [ -z "$TMUX_FZF_OPTIONS_USER" ] && [ "$compact_client" == "1" ]; then
  TMUX_FZF_PREVIEW=0
  if [ $(compare_float $tmux_version "3.1") == ">" ]; then
    TMUX_FZF_OPTIONS="-p -w 96% -h 88% -m --info=inline --padding='1,0,0,0'"
  else
    TMUX_FZF_OPTIONS="-m --info=inline"
  fi
elif [ $(compare_float $tmux_version "3.1") == ">" ]; then
  [ -z "$TMUX_FZF_OPTIONS" ] && TMUX_FZF_OPTIONS="-p -w 62% -h 38% -m"
else
  [ -z "$TMUX_FZF_OPTIONS" ] && TMUX_FZF_OPTIONS="-m"
fi

# $TMUX_FZF_CLIENT_ARG
# Commands executed via "tmux run-shell -b" have no client context, so tmux
# falls back to the most recently active client - which may be a different
# terminal when multiple clients are attached. When $TMUX_FZF_CLIENT is set,
# all client-dependent commands are pinned to that client via -c.
TMUX_FZF_CLIENT_ARG=""
[ -n "$TMUX_FZF_CLIENT" ] && TMUX_FZF_CLIENT_ARG="-c $TMUX_FZF_CLIENT"

# Unset temporary variables and functions.
unset \
  current_dir \
  compare_float \
  fzf_version \
  fzf_version_1 \
  fzf_version_2 \
  fzf_preview_window_follow \
  tmux_version
