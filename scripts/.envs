#!/usr/bin/env bash

current_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Compact client detection - before the preview block below, because the
# compact layout turns the preview off.
#
# A client is "compact" when it is too narrow OR too short:
#   TMUX_FZF_CLIENT_WIDTH  / TMUX_FZF_CLIENT_HEIGHT, from the client that
#     pressed the key (main.tmux passes both). Phones report plenty of
#     columns and few rows - Termius in portrait is ~430x65, but a landscape
#     phone or a short split terminal is wide and cramped at the same time -
#     so a popup proportioned for a desktop window does not fit, and a preview
#     pane eats the width that makes the list readable.
#   The thresholds are fixed at 140 columns / 30 rows: generous desktop
#   windows clear both, phones and short splits do not.
#
# The comparison happens here (not in tmux) so a non-numeric dimension from an
# exotic client cannot break the shell test.
compact_client=0
if [ -n "$TMUX_FZF_CLIENT_WIDTH" ] && [ -n "$TMUX_FZF_CLIENT_HEIGHT" ]; then
    case "$TMUX_FZF_CLIENT_WIDTH$TMUX_FZF_CLIENT_HEIGHT" in
        *[!0-9]*) : ;;   # not a plain pair of integers, skip the comparison
        *)
            if [ "$TMUX_FZF_CLIENT_WIDTH" -lt 140 ] || [ "$TMUX_FZF_CLIENT_HEIGHT" -lt 30 ]; then
                compact_client=1
                TMUX_FZF_PREVIEW=0
            fi
            ;;
    esac
fi

# $TMUX_FZF_PREVIEW_OPTIONS && $TMUX_FZF_PREVIEW_SESSION_OPTIONS — arrays,
# expanded as "${TMUX_FZF_PREVIEW_OPTIONS[@]}", so no eval and no quoting
# games at the call sites. Empty when the preview is off.
TMUX_FZF_PREVIEW="${TMUX_FZF_PREVIEW:-1}"
if [ "$TMUX_FZF_PREVIEW" == 1 ]; then
  TMUX_FZF_PREVIEW_OPTIONS=(--preview "$current_dir/.preview {}" --preview-window :follow)
  TMUX_FZF_PREVIEW_SESSION_OPTIONS=(--preview "$current_dir/.preview-session {}" --preview-window :follow)
else
  TMUX_FZF_PREVIEW_OPTIONS=()
  TMUX_FZF_PREVIEW_SESSION_OPTIONS=()
fi

# Popup geometry and multi-select: the plugin's defaults. They are PREPENDED
# to FZF_DEFAULT_OPTS, so anything the user added there (pushed into the tmux
# global environment — the pickers are run-shell children of the server and
# inherit it, see README) comes later and wins per fzf's precedence. No
# TMUX_FZF_OPTIONS knob anymore: the user's own FZF_DEFAULT_OPTS --tmux flag
# replaces the geometry, which is also how a pinned layout beats the compact
# one on a phone.
#
# --tmux is native since fzf 0.53 and ignored outside tmux; -m enables the
# TAB marking that kill/join rely on.
if [ "$compact_client" == "1" ]; then
  plugin_opts="--tmux center,96%,88% -m --info=inline --padding 1,0,0,0"
else
  plugin_opts="--tmux center,62%,38% -m"
fi
export FZF_DEFAULT_OPTS="$plugin_opts ${FZF_DEFAULT_OPTS:-}"

# $TMUX_FZF_CLIENT_ARG
# Commands executed via "tmux run-shell -b" have no client context, so tmux
# falls back to the most recently active client - which may be a different
# terminal when multiple clients are attached. When $TMUX_FZF_CLIENT is set,
# all client-dependent commands are pinned to that client via -c.
TMUX_FZF_CLIENT_ARG=""
[ -n "$TMUX_FZF_CLIENT" ] && TMUX_FZF_CLIENT_ARG="-c $TMUX_FZF_CLIENT"

# Unset temporary variables and functions.
unset \
  current_dir \
  compact_client \
  plugin_opts
